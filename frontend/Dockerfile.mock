# 仅用于本地/演示：构建带 mock 数据的前端镜像，不依赖后端
# 构建：docker build -f Dockerfile.mock -t g12-web:mock .
# 运行：docker run -d --name g12-web-demo -p 8080:80 g12-web:mock
# Element Plus 2.14 依赖 @vueuse/core 15，要求 Node >= 22
FROM node:22-alpine AS build
# 容器内 DNS 可能只返回 IPv6，强制 IPv4 优先，避免 npm 下载中途崩溃
ENV NODE_OPTIONS=--dns-result-order=ipv4first
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# development 模式读取 .env.development 的 VITE_USE_MOCK=true
RUN npm run build -- --mode development

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
# mock 模式下 /api 由浏览器内的 axios adapter 拦截，nginx 不真正访问后端
ENV BACKEND_HOST=127.0.0.1 \
    BACKEND_PORT=8080 \
    TZ=Asia/Shanghai
EXPOSE 80
